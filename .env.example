# Moduscript / MCmodAgent 环境配置（示例模板）
# 首次使用：复制为 .env 后按说明修改；修改后需重启服务方可生效
#   Windows: copy .env.example .env
#   启动: scripts\run.ps1 或 server\start.bat

# =============================================================================
# 认证与安全
# =============================================================================

# JWT 签名密钥（生产环境必须为长随机字符串；勿提交到 Git）
JWT_SECRET=change-this-to-a-long-random-string
# 用户登录 token 有效期（天）
JWT_EXPIRE_DAYS=7
# 设为 true 时，若 JWT_SECRET 仍为默认值则拒绝启动（A 测/生产建议开启）
# MCMOD_REQUIRE_STRONG_SECRETS=true

# 首个管理员邮箱：使用该邮箱注册时自动获得 admin 角色
MCMOD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 管理后台独立口令（访问 /admin.html，与账号密码无关；站内无入口链接）
MCMOD_ADMIN_PASSWORD=change-me-admin-password

# 浏览器跨域白名单，逗号分隔；不设置则允许所有来源（开发方便，公网建议收紧）
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# =============================================================================
# 数据与运行模式
# =============================================================================

# 运行时数据目录（用户、会话 JSON、工作区、日志）；默认项目根目录下 data/
# MCMOD_DATA_DIR=./data

# 是否使用内存 mock 会话（true=无需 Claude CLI，仅前端/接口联调；生产必须为 false）
USE_MOCK_SESSIONS=false

# =============================================================================
# LLM / Agent（也可在 /admin.html 配置，会写入 data/admin/llm_shared.json）
# =============================================================================

# Anthropic 兼容 API（Claude Agent 编写模组时使用）
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# CLAUDE_CODE_SUBAGENT_MODEL=

# Claude Code CLI 可执行文件路径（一般留空自动检测）
# CLAUDE_CLI_PATH=

# DeepSeek API（模组名/包名自动填充、描述优化等辅助功能，可选）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_OPTIMIZE_MODEL=deepseek-v4-pro
# DEEPSEEK_OPTIMIZE_REASONING_EFFORT=high

# =============================================================================
# Fabric 工作区 bootstrap（需先执行 playwright install chromium）
# =============================================================================

MOD_TEMPLATE_PACKAGE=com.example
MOD_TEMPLATE_MINECRAFT_VERSION=1.20.1
MOD_TEMPLATE_URL=https://fabricmc.net/develop/template/
MOD_TEMPLATE_PAGE_TIMEOUT_MS=120000
MOD_TEMPLATE_DOWNLOAD_TIMEOUT_MS=120000
MOD_TEMPLATE_MAX_RETRIES=3
MOD_TEMPLATE_RETRY_DELAY_SEC=3

# Gradle 编译超时（秒）；下载 jar 前 build 步骤
GRADLE_BUILD_TIMEOUT_SEC=600

# =============================================================================
# A 测可用性（单节点保护：防止个别会话占满资源拖垮整站）
# =============================================================================

# 同时进行 Agent 编写/setup 的最大会话数；0=不限制（开发可用 0，A 测建议 8–12）
# SESSION_MAX_ACTIVE=10
# 同时进行 gradlew build 的最大数量；0=不限制（建议 2，与 CPU 核数匹配）
# GRADLE_MAX_CONCURRENT=2
# 发版/重启时等待进行中的请求结束的最长时间（秒）
# UVICORN_GRACEFUL_TIMEOUT=30

# 健康检查（供 systemd / 反代 / 监控使用，无需改 env）：
#   GET /health/live   — 进程存活
#   GET /health/ready  — 可接新流量（含当前并发槽位统计）

# =============================================================================
# 日志与审计
# =============================================================================

# LOG_DIR=./data/logs
# LOG_LEVEL=INFO
# AUDIT_JSONL_ENABLED=true
# AUDIT_RETENTION_DAYS=30
# UVICORN_ACCESS_LOG=false

# =============================================================================
# 远程部署接收器（deploy/ 工具推送代码用，本地开发可忽略）
# =============================================================================

# 部署连接预共享密钥（与 deploy/config/receiver.json 中 psk 一致）
# DEPLOY_TOKEN=change-me-deploy-token
# 接收器监听地址与端口
# DEPLOY_RECEIVER_HOST=0.0.0.0
# DEPLOY_RECEIVER_PORT=9001
